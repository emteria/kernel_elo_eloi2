		<0xff 346>;

		qcom,gpio-parent = <&tlmm>;
		qcom,gpio-map = <3 38 >,
		<4 1 >,
		<5 5 >,
		<6 9 >,
		<8 37>,
		<9 36>,
		<10 13>,
		<11 35>,
		<12 17>,
		<13 21>,
		<14 54>,
		<15 34>,
		<16 31>,
		<17 58>,
		<18 28>,
		<19 42>,
		<20 25>,
		<21 12>,
		<22 43>,
		<23 44>,
